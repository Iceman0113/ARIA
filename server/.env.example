# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Company identity — Jack & Jewell specific
COMPANY_NAME=Jack & Jewell Consulting LLC
COFOUNDER_NAME=ARIA
FOUNDER_NAME=Randy
BUSINESS_DESCRIPTION=IT managed services and AI consulting firm based in Greenwood, Indiana

# Supabase (replaces JSON files — get from supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — revenue monitoring (existing Stripe key for your own subscriptions)
STRIPE_SECRET_KEY=sk_live_...

# Buffer — LinkedIn scheduling (bufferapp.com)
BUFFER_ACCESS_TOKEN=...
BUFFER_PROFILE_ID=...

# Serper — web search for Scout + Hunter (serper.dev, 2500 free queries/month)
SERPER_API_KEY=...

# Competitors to monitor (comma-separated pricing/feature page URLs)
COMPETITOR_URLS=https://competitor1.com/pricing,https://competitor2.com/features

# Financial targets
BRIDGE_MRR_TARGET=16500
BRIDGE_NET_TARGET=11000
DAY_JOB_INCOME=8200

# Server
PORT=3001
RANDY_EMAIL=randy@jackandjewell.com
CRON_TIMEZONE=America/Indiana/Indianapolis

# Voice cloning (self-hosted XTTS). Leave TTS_PROVIDER unset to use Edge TTS.
TTS_PROVIDER=clone
CLONE_TTS_URL=http://localhost:8020
CLONE_TTS_TIMEOUT_MS=20000
